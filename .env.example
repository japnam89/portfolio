# Copy this file to ".env.local" and fill in your real values.
# .env.local is git-ignored, so your secrets are never committed.

# --- Contact form (Resend) ---
# Your Resend API key — get one free at https://resend.com (10k emails/mo free).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The email address that receives contact-form messages.
# Must be a domain you've verified in Resend, OR use the test address below
# while in sandbox mode:
CONTACT_TO_EMAIL=you@example.com

# (Optional) the "from" address — Resend gives you a sandbox sender by default.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# --- Photography gallery (Hostinger Object Storage / RustFS, S3-compatible) ---
# Uses @aws-sdk/client-s3 with forcePathStyle. Verified working: the JfMz../RkGD..
# key lists + reads the "photos" bucket (DSC07956/66/68/69.JPG). No session token
# needed — these are permanent access-key creds.

# Public S3 gateway host (reachable, serves images).
RUSTFS_ENDPOINT=https://rustfs-dkgj.srv1865422.hstgr.cloud

# AWS region for the bucket (us-east-1 for Hostinger RustFS).
RUSTFS_REGION=us-east-1

# Permanent access key + secret for the "photos" bucket.
RUSTFS_ACCESS_KEY=JfMzX0Xv5ySZW4aTMFKi
RUSTFS_SECRET_KEY=RkGDLBKE7BK1nHWAjgEGdWUcZAWFfpH5zrn0aXpv

# Bucket that holds the photos (objects are keyed bare, e.g. DSC08068.JPG).
RUSTFS_BUCKET=photos

# Presigned GET URL lifetime in seconds (gallery auto-refreshes before expiry).
RUSTFS_URL_EXPIRES=3600

# Optional fallback: comma-separated WORKING presigned URLs. If set, /api/photos
# serves these directly instead of listing the bucket. Leave empty to use the
# live S3 listing above.
DEMO_PHOTO_URLS=

# --- Blog admin (SQLite-backed posts) ---
# Password that protects POST /api/posts (publishing from /admin/posts/new).
# Send it as a Bearer token. If unset, the admin API returns 503.
POST_ADMIN_PASSWORD=change-me

# Optional: address to notify when a new blog post is published. Defaults to
# CONTACT_TO_EMAIL if unset. Requires RESEND_API_KEY to actually send.
BLOG_NOTIFY_EMAIL=

# "Buy me a coffee" button target (PayPal). Set to your PayPal.me / donate URL.
# Inlined at build time (NEXT_PUBLIC_*), so set it before `npm run build`.
NEXT_PUBLIC_PAYPAL_URL=https://paypal.me/japnam89
